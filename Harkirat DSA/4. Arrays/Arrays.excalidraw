        }
      ],
      "updated": 1779311362863,
      "link": null,
      "locked": false,
      "text": "int n;\ncin >> n;\n\nint a[n];\nfor(int i = 0; i < n; i++)\n{\n    cin >> a[i];\n}\n\nbool flag = false;\n\nfor(int i = 1; i < n; i++)\n{\n\n    if(a[i] < a[i - 1])\n    {\n        // array is not sorted\n\n        flag = true;\n        break;\n    }\n\n}\n\nif(flag)\n{\n    cout << \"NOT SORTED\";\n}\nelse\n{\n    cout << \"SORTED\";\n}\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int n;\ncin >> n;\n\nint a[n];\nfor(int i = 0; i < n; i++)\n{\n    cin >> a[i];\n}\n\nbool flag = false;\n\nfor(int i = 1; i < n; i++)\n{\n\n    if(a[i] < a[i - 1])\n    {\n        // array is not sorted\n\n        flag = true;\n        break;\n    }\n\n}\n\nif(flag)\n{\n    cout << \"NOT SORTED\";\n}\nelse\n{\n    cout << \"SORTED\";\n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
