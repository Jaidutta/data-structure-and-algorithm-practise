      "updated": 1770310332217,
      "link": null,
      "locked": false,
      "text": "int c0 = 0, c1 = 0;\n\nfor(int i = 0; i < n; i++)\n{\n    if(a[i] == 0)\n    {\n        c0++;\n    }\n    else\n    {\n        c1++;\n    }\n}\n\n// print all 0's\nfor(int i = 1; i <= c0; i++)\n{\n    cout << \"0 \"; \n}\n\n\n\n// print all 1's\nfor(int i = 1; i <= c1; i++)\n{\n    cout << \"1 \"; \n}\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int c0 = 0, c1 = 0;\n\nfor(int i = 0; i < n; i++)\n{\n    if(a[i] == 0)\n    {\n        c0++;\n    }\n    else\n    {\n        c1++;\n    }\n}\n\n// print all 0's\nfor(int i = 1; i <= c0; i++)\n{\n    cout << \"0 \"; \n}\n\n\n\n// print all 1's\nfor(int i = 1; i <= c1; i++)\n{\n    cout << \"1 \"; \n}\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
