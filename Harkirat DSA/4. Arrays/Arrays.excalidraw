      "isDeleted": false,
      "boundElements": [],
      "updated": 1770310625614,
      "link": null,
      "locked": false,
      "text": "int ans;\n\nfor(int i = 0; i < n; i++)\n{\n    // test whether a[i] is the ans or not\n    \n    int target = a[i];\n    int count = 0;\n\n    for(int j = 0; j < n; j++)\n    {\n        if(a[j] == target)\n        {\n            count++;\n        }\n    }\n\n    if(count == 1)\n    {\n        ans = a[i];\n        break;\n    }\n}\n\ncout << ans << endl;",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int ans;\n\nfor(int i = 0; i < n; i++)\n{\n    // test whether a[i] is the ans or not\n    \n    int target = a[i];\n    int count = 0;\n\n    for(int j = 0; j < n; j++)\n    {\n        if(a[j] == target)\n        {\n            count++;\n        }\n    }\n\n    if(count == 1)\n    {\n        ans = a[i];\n        break;\n    }\n}\n\ncout << ans << endl;",
      "autoResize": true,
      "lineHeight": 1.25
    },
