      "link": null,
      "locked": false,
      "text": "int ans = 1;\n\nfor(int i = 1; i <= n; i++)\n{\n    if(n % i == 0 and m % i == 0) // i is a factor of both n and m\n    {\n        ans = i;\n    }\n}\n\ncout << ans << endl;\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int ans = 1;\n\nfor(int i = 1; i <= n; i++)\n{\n    if(n % i == 0 and m % i == 0) // i is a factor of both n and m\n    {\n        ans = i;\n    }\n}\n\ncout << ans << endl;\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
