      "updated": 1770310332217,
      "link": null,
      "locked": false,
      "text": "int n;\ncin >> n;\n\nint target;\ncin >> target;\n\nint a[n];\nfor(int i = 0; i < n; i++)\n{\n    cin >> a[i];\n}\n\nint count = 0;\n\nfor(int i = 0; i < n; i++)\n{\n    if(a[i] == target)\n    {\n        count++;\n    }\n}\n\ncout << count << endl;",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int n;\ncin >> n;\n\nint target;\ncin >> target;\n\nint a[n];\nfor(int i = 0; i < n; i++)\n{\n    cin >> a[i];\n}\n\nint count = 0;\n\nfor(int i = 0; i < n; i++)\n{\n    if(a[i] == target)\n    {\n        count++;\n    }\n}\n\ncout << count << endl;",
      "autoResize": true,
      "lineHeight": 1.25
    },
