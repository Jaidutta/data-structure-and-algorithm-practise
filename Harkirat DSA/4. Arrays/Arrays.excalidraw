      "isDeleted": false,
      "boundElements": [],
      "updated": 1770311321251,
      "link": null,
      "locked": false,
      "text": "int ans;\n\nfor(int i = 0; i < n; i++)\n{\n\n    // check how many times a[i] occurs in the array\n    \n    int count = 0;\n    for(int j = 0; j < n; j++)\n    {\n        if(a[j] == a[i])\n        {\n            count++;\n        }\n    }  \n\n\n     if(count == 1)\n    {\n        ans = a[i];\n        break;\n    }\n}\n\n\ncout << ans << endl;\n\n",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "int ans;\n\nfor(int i = 0; i < n; i++)\n{\n\n    // check how many times a[i] occurs in the array\n    \n    int count = 0;\n    for(int j = 0; j < n; j++)\n    {\n        if(a[j] == a[i])\n        {\n            count++;\n        }\n    }  \n\n\n     if(count == 1)\n    {\n        ans = a[i];\n        break;\n    }\n}\n\n\ncout << ans << endl;\n\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
