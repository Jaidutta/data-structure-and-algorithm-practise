      "updated": 1781636660033,
      "link": null,
      "locked": false,
      "text": "if(checkIthBit(N,0) == 0\n  Even\n\nelse: \n  Odd\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "if(checkIthBit(N,0) == 0\n  Even\n\nelse: \n  Odd\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "cpPXLOZlJeWc54f7kdutA",
      "type": "rectangle",
