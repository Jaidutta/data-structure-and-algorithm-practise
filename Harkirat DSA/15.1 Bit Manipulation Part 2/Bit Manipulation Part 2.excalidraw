      "link": null,
      "locked": false,
      "text": "ans = N;\n\nfor(int i = 0; i < K i++)\n{\n    if(checkIthBit(N, i) == 1)\n    {\n         ans = unsetIthBit(N, i);\n         break;\n    }\n}\n\nreturn ans;",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ans = N;\n\nfor(int i = 0; i < K i++)\n{\n    if(checkIthBit(N, i) == 1)\n    {\n         ans = unsetIthBit(N, i);\n         break;\n    }\n}\n\nreturn ans;",
      "autoResize": true,
      "lineHeight": 1.25
    },
