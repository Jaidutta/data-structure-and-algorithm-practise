    {
      "id": "PvhpYzzCQDAiC5H05NnYV",
      "type": "text",
      "x": 326525.35486270714,
      "y": -8731.625044275903,
      "width": 300.61981201171875,
      "height": 525,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0Mn",
      "roundness": null,
      "seed": 300868477,
      "version": 257,
      "versionNonce": 1264418867,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1777193593619,
      "link": null,
      "locked": false,
      "text": "ans = 0\n\nfor(j = 0; j < K; j++)\n{\n    sum = 0\n\n    for(i = 0; i < N; i++)\n    {\n        if(checkBit(A[i], j) == 1)\n        {\n            sum++\n        }\n    }\n    \n    if(sum % 3 != 0)\n    {\n        ans = setBit(ans, j);\n    }\n}\n\nreturn ans",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ans = 0\n\nfor(j = 0; j < K; j++)\n{\n    sum = 0\n\n    for(i = 0; i < N; i++)\n    {\n        if(checkBit(A[i], j) == 1)\n        {\n            sum++\n        }\n    }\n    \n    if(sum % 3 != 0)\n    {\n        ans = setBit(ans, j);\n    }\n}\n\nreturn ans",
      "autoResize": true,
      "lineHeight": 1.25
    },
