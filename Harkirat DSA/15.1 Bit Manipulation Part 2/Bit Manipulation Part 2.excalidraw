      "updated": 1781689258498,
      "link": null,
      "locked": false,
      "text": "If the hash function is not built\neffeciently, it can blow up in N^2, so\nthe bit manipulation is a better choice\nin that case we can use a \nsorted map or a tree map",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If the hash function is not built\neffeciently, it can blow up in N^2, so\nthe bit manipulation is a better choice\nin that case we can use a \nsorted map or a tree map",
      "autoResize": true,
      "lineHeight": 1.25
