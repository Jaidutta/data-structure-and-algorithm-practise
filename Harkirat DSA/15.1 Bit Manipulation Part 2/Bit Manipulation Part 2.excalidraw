      "isDeleted": false,
      "boundElements": null,
      "updated": 1781686222290,
      "link": null,
      "locked": false,
      "text": "k is either 0 -30, for 32 bits(int), 1 bit is signed \nso we consider 31 bits and index start at 0 and hence\n0 -30\n\nfor 64 bits(int), 1 bit is signed \nso we consider 63 bits and index start at 0 and hence\n0 - 62",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "k is either 0 -30, for 32 bits(int), 1 bit is signed \nso we consider 31 bits and index start at 0 and hence\n0 -30\n\nfor 64 bits(int), 1 bit is signed \nso we consider 63 bits and index start at 0 and hence\n0 - 62",
      "autoResize": true,
      "lineHeight": 1.25
    },
