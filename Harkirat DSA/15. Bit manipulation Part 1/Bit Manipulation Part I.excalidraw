      "link": null,
      "locked": false,
      "text": "cnt = 0\n\nfor(i = 30; i >= 0; i--)\n{\n    if(checkIthBit(N, i)\n    {\n        cnt++\n    }\n}\n\nprint(cnt)",
      "fontSize": 20.632465742056425,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "cnt = 0\n\nfor(i = 30; i >= 0; i--)\n{\n    if(checkIthBit(N, i)\n    {\n        cnt++\n    }\n}\n\nprint(cnt)",
      "autoResize": true,
      "lineHeight": 1.25
    },
