      "isDeleted": false,
      "boundElements": null,
      "updated": 1781555908282,
      "link": null,
      "locked": false,
      "text": "By unset, we want that bit in the answer to be 0, we want to generate a number\nthat has all the other bits as 1 but that specific bit as 0 so that after & ing\nall the bits of the original number remains intact but that particular bit will be \nset to 0 ",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "By unset, we want that bit in the answer to be 0, we want to generate a number\nthat has all the other bits as 1 but that specific bit as 0 so that after & ing\nall the bits of the original number remains intact but that particular bit will be \nset to 0 ",
      "autoResize": true,
      "lineHeight": 1.25
    },
