      "updated": 1776963659469,
      "link": null,
      "locked": false,
      "text": "checkIthBit(N, i):\n\n    mask = 1 << i\n\n    return (mask & N) == 0 ? 0 : 1\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "checkIthBit(N, i):\n\n    mask = 1 << i\n\n    return (mask & N) == 0 ? 0 : 1\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
